<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- One dependency row in the options panel: addon name left, status and use right (Dependencies.lua) -->
  <Frame name="KeepOrSellDependencyTemplate" inherits="SettingsListElementTemplate" mixin="KeepOrSellDependencyMixin" virtual="true">
    <Size x="280" y="26"/>
    <Layers>
      <Layer level="OVERLAY">
        <FontString parentKey="Status" inherits="GameFontHighlight" justifyH="LEFT" wordwrap="false">
          <Anchors>
            <Anchor point="LEFT" relativePoint="CENTER" x="-80"/>
            <Anchor point="RIGHT" x="-10"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Scripts>
      <!-- SettingsListElementMixin:OnLoad sets up cbrHandles, which Init needs; the base template doesn't call it -->
      <OnLoad method="OnLoad"/>
    </Scripts>
  </Frame>
  <!-- Up to two lines of small text in the options panel: the alt page's intro, why the list is empty (Options.lua) -->
  <Frame name="KeepOrSellNoteTemplate" inherits="SettingsListElementTemplate" mixin="KeepOrSellNoteMixin" virtual="true">
    <Size x="280" y="40"/>
    <Layers>
      <Layer level="OVERLAY">
        <FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT" wordwrap="true">
          <Anchors>
            <Anchor point="LEFT" x="37"/>
            <Anchor point="RIGHT" x="-10"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad method="OnLoad"/>
    </Scripts>
  </Frame>
</Ui>
